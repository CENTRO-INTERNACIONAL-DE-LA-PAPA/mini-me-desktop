# =========================================================================
# Mini-Me / Ask-the-Data — environment template
# Copy to `.env` and fill in your own values. Do not commit `.env`.
# =========================================================================

# --- Required ------------------------------------------------------------

# Chat model. The agent uses `openai:gpt-5.4` via langchain init_chat_model;
# any OpenAI key with access to that model works.
OPENAI_API_KEY=

# LangSmith — drives both the per-thread sandbox provisioning
# (`langsmith.sandbox.AsyncSandboxClient`) and the optional trace upload.
LANGSMITH_API_KEY=

# Asta (Allen Institute) academic-research MCP server.
ASTA_API_KEY=

# Asta CLI auth token, passed into the per-thread sandbox so the `asta` CLI
# (theory generation, DataVoyager, PDF extraction) can authenticate.
# Generate with: asta auth print-token --raw --refresh
ASTA_TOKEN=

# --- Auth (required in production, optional in dev) ----------------------

# WorkOS AuthKit client id. Used to fetch the per-client JWKS so we can
# verify access-token signatures. Get yours at https://dashboard.workos.com
# → Applications. Without this, production mode rejects all requests; dev
# mode falls back to a stub identity (DEEP_ATD_LOCAL_USER_ID).
WORKOS_CLIENT_ID=

# WorkOS API key (server-side, never exposed to the frontend). Used to
# resolve the caller's email from their user id via the WorkOS API
# (access tokens don't carry email). If unset, the backend skips the
# email-domain check and trusts the WorkOS organization domain policy
# as the only barrier. Get one at the WorkOS dashboard → API Keys.
WORKOS_API_KEY=

# Comma-separated email-domain allowlist. Users whose email does not end
# with one of these domains are rejected (403). Only enforced when
# WORKOS_API_KEY is configured.
AUTH_ALLOWED_EMAIL_DOMAINS=cgiar.org

# --- Optional ------------------------------------------------------------

# Set to `production` to require authenticated `runtime.server_info`
# (assistant_id + user identity). When unset or "development", the
# fallbacks below kick in so `langgraph dev` works without auth.
# DEEP_ATD_RUNTIME_MODE=development

# Dev fallbacks used when LangGraph Server hasn't injected identity.
# These do NOT apply in production mode (the agent will raise).
# DEEP_ATD_LOCAL_ASSISTANT_ID=local-assistant
# DEEP_ATD_LOCAL_USER_ID=local-user
# DEEP_ATD_LOCAL_THREAD_ID=langgraph-dev-preview

# Set to "true" to fail when a request arrives without a thread_id
# (useful for catching frontend bugs in staging).
# DEEP_ATD_REQUIRE_THREAD_ID=false

# Custom LangSmith Sandbox snapshot to boot per-thread sandboxes from.
# The default `mini-me-base` is built by `scripts/build_sandbox_snapshot.py`
# and bundles pandas, scikit-learn, pymc, typst, pandoc, and friends so
# cold-start is ~5s instead of pip-installing each turn.
# MINIME_SANDBOX_SNAPSHOT=mini-me-base

# LangSmith tracing. Set to "false" to disable the trace upload entirely
# (sandbox provisioning still works because it uses the same key directly).
# LANGSMITH_TRACING=true
