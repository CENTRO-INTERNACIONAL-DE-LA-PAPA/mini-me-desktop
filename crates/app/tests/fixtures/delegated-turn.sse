data: {"structured_response":{"summary":"The canonical DESeq2 paper is the 2014 Genome Biology article that introduced the DESeq2 method and is widely treated as the primary citation for the software and its statistical framework.","sources":[{"citation":"Love, M. I., Huber, W., & Anders, S. (2014). Moderated estimation of fold change and dispersion for RNA-seq data with DESeq2. Genome Biology, 15, 550. https://doi.org/10.1186/s13059-014-0550-8","relevance":"This is considered the main DESeq2 paper because it introduces the DESeq2 method itself, including its core statistical framework for differential expression analysis of RNA-seq count data.","link":"https://doi.org/10.1186/s13059-014-0550-8"}]},"files":{},"artifacts":{"datasets":[],"sources":[{"citation":"Love, M. I., Huber, W., & Anders, S. (2014). Moderated estimation of fold change and dispersion for RNA-seq data with DESeq2. Genome Biology, 15, 550. https://doi.org/10.1186/s13059-014-0550-8","relevance":"This is considered the main DESeq2 paper because it introduces the DESeq2 method itself, including its core statistical framework for differential expression analysis of RNA-seq count data.","link":"https://doi.org/10.1186/s13059-014-0550-8"}],"reports":[],"files":[],"hypotheses":[],"libraries":[],"analyses":[],"edges":[{"source":"source:https://doi.org/10.1186/s13059-014-0550-8","target":"subagent:academic_researcher","relation":"produced_by","source_kind":"source","target_kind":"subagent","source_label":"Love, M. I., Huber, W., & Anders, S. (2014). Moderated estimation of fold change and dispersion for RNA-seq data with D…","target_label":"Academic search"}],"project":{"mission":"In one short paragraph, what is your role as the Mini-Me coordinator?","completed":[],"pending":[],"suggestions":[]}}}

